{
  "name": "industrial-twin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=26 <27", "pnpm": ">=10" },
  "scripts": {
    "gallery": "pnpm --filter @twin/gallery dev",
    "gallery:build": "pnpm --filter @twin/gallery build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "video:configure": "node video-production/video-pipeline.mjs",
    "video:voice": "node video-production/voiceover.mjs",
    "video:voice:test": "node --test video-production/voiceover.test.mjs"
  }
}
