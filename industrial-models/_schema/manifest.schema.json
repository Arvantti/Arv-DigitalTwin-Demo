{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industrial model manifest",
  "type": "object",
  "required": ["schema_version", "model", "entrypoints", "equipment_dependencies"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "runtime"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "runtime": { "type": "string" }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": ["layout", "simulation"],
      "properties": {
        "layout": { "type": "string" },
        "simulation": { "type": "string" },
        "domain_model": { "type": "string" }
      }
    },
    "equipment_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "version"],
        "properties": {
          "type": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    }
  }
}
