{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.online/schemas/catalog.schema.json",
  "title": "Catálogo de datos de una planta",
  "description": "Modelo de datos común de los gemelos (docs/datos-reales.md). Se valida la unión de los archivos de industrial-models/<planta>/catalog/*.yaml.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
    "tooling": { "type": "array", "items": { "$ref": "#/$defs/tooling" } },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } },
    "equipment_sizes": { "type": "array", "items": { "$ref": "#/$defs/equipmentSizes" } },
    "setup": { "type": "object", "additionalProperties": { "$ref": "#/$defs/mounted" } },
    "orders": { "type": "array", "items": { "$ref": "#/$defs/order" } },
    "schedule": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
    "demand": { "$ref": "#/$defs/demand" },
    "changeovers": { "$ref": "#/$defs/changeovers" },
    "energy": { "$ref": "#/$defs/energy" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "range": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
    "material": {
      "type": "object",
      "required": ["id", "name", "kind", "unit"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "kind": { "enum": ["resin", "masterbatch", "ingredient", "packaging", "paper", "other"] },
        "resin": { "type": "string", "description": "Valor del parámetro material de la inyectora" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "dosage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "density_kg_l": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["kg", "l", "u", "m2"] },
        "cost_per_unit": { "type": "number", "minimum": 0 },
        "assumed": { "type": "boolean" }
      }
    },
    "tooling": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["mold", "recipe", "die", "format"] },
        "name": { "type": "string" },
        "product": { "$ref": "#/$defs/id", "description": "Producto que hace (obligatorio salvo en formatos, que pueden servir a varios)" },
        "size": { "type": "string", "description": "Tamaño legible (250 ml, 600 × 400 × 400 mm)" },
        "layout_types": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Tipos del plant.yaml donde puede montarse" },
        "params": { "type": "object", "description": "Parámetros que el herramental montado impone al equipo en la simulación (unit_ml de un formato, boxes_per_sheet de un troquel)" },
        "formula_pct": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }, "description": "Receta: material del catálogo → % en masa" },
        "yield_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "material": { "$ref": "#/$defs/id" },
        "cavities": { "type": "integer", "minimum": 1 },
        "part_g": { "type": "number", "exclusiveMinimum": 0 },
        "cycle_s": { "type": "number", "exclusiveMinimum": 0 },
        "shot_kg": { "type": "number", "exclusiveMinimum": 0 },
        "min_clamp_t": { "type": "number", "exclusiveMinimum": 0 },
        "batch_kg": { "type": "number", "exclusiveMinimum": 0 },
        "change_min": { "type": "number", "minimum": 0, "description": "Tiempo de cambio (montaje, limpieza o CIP)" },
        "copies": { "type": "integer", "minimum": 1, "description": "Copias físicas del herramental; cada una se monta en un solo equipo a la vez" },
        "assumed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "mold" } } },
          "then": { "required": ["product", "material", "cavities", "part_g", "cycle_s", "shot_kg", "min_clamp_t"] }
        },
        {
          "if": { "properties": { "kind": { "const": "recipe" } } },
          "then": { "required": ["product", "batch_kg", "formula_pct"] }
        },
        {
          "if": { "properties": { "kind": { "const": "die" } } },
          "then": { "required": ["product"] }
        }
      ]
    },
    "stage": {
      "type": "object",
      "required": ["stage", "equipment"],
      "additionalProperties": false,
      "properties": {
        "stage": { "type": "string" },
        "equipment": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Equipos del plant.yaml donde puede hacerse la etapa" },
        "tooling": { "$ref": "#/$defs/id" },
        "cycle_s": { "type": "number", "exclusiveMinimum": 0, "description": "Tiempo unitario: segundos por unidad del producto" },
        "batch_qty": { "type": "number", "exclusiveMinimum": 0, "description": "Lote mínimo de la etapa, en unidades del producto" },
        "batch_min": { "type": "number", "exclusiveMinimum": 0, "description": "Duración del lote" },
        "operators": { "type": "integer", "minimum": 0 },
        "transfer_min": { "type": "number", "minimum": 0, "description": "Tiempo hasta la etapa siguiente" }
      }
    },
    "product": {
      "type": "object",
      "required": ["id", "name", "kind", "unit", "routing"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "family": { "type": "string" },
        "allergen_group": { "$ref": "#/$defs/id", "description": "Grupo de alérgenos del producto; lo usa la tabla changeovers.allergen" },
        "kind": { "enum": ["finished", "semi"] },
        "unit": { "enum": ["u", "kg", "l"] },
        "size": { "type": "string", "description": "Presentación o tamaño (250 ml, grande…)" },
        "display_name": { "type": "string", "description": "Texto que muestra el equipo que lo produce" },
        "colors": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Color con que la escena dibuja el producto si no tiene colores de masterbatch" },
        "bulk_l": { "type": "number", "exclusiveMinimum": 0, "description": "Volumen por pieza en la estiba" },
        "tolerance_pct": { "type": "number", "minimum": 0, "description": "Tolerancia relativa al tamaño de la presentación" },
        "bom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "qty"],
            "additionalProperties": false,
            "properties": { "item": { "$ref": "#/$defs/id" }, "qty": { "type": "number", "exclusiveMinimum": 0 } }
          }
        },
        "routing": { "type": "array", "items": { "$ref": "#/$defs/stage" }, "minItems": 1 },
        "assumed": { "type": "boolean" }
      }
    },
    "equipmentSizes": {
      "type": "object",
      "required": ["type", "sizes"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "description": "Tipo de la librería" },
        "layout_type": {
          "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }],
          "description": "Tipo (o tipos) con que aparece en plant.yaml"
        },
        "by": { "type": "string", "description": "Parámetro del plant.yaml que define el tamaño (por defecto clamp_t)" },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string" },
              "clamp_t": { "$ref": "#/$defs/range" },
              "range": { "$ref": "#/$defs/range", "description": "Rango del parámetro by" },
              "equipment": { "type": "array", "items": { "type": "string" }, "description": "Equipos de este tamaño, cuando ningún parámetro lo define" },
              "max_shot_kg": { "$ref": "#/$defs/range" },
              "presets": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "energyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_kw", "standby_kw", "off_kw", "heatup_min", "heatup_kwh"],
      "description": "Lo que mide el modelo físico de la inyectora con un molde montado",
      "properties": {
        "run_kw": { "type": "number", "minimum": 0, "description": "Potencia media produciendo" },
        "standby_kw": { "type": "number", "minimum": 0, "description": "Encendida y a temperatura, sin ciclar (espera caliente)" },
        "off_kw": { "type": "number", "minimum": 0, "description": "Apagada (solo el control)" },
        "heatup_min": { "type": "number", "minimum": 0, "description": "Minutos de calentamiento en frío hasta la temperatura de la resina" },
        "heatup_kwh": { "type": "number", "minimum": 0, "description": "Energía del calentamiento en frío" },
        "kwh_per_kg": { "type": ["number", "null"], "minimum": 0, "description": "Energía específica produciendo" },
        "run_peak_kw": { "type": "number", "minimum": 0, "description": "Pico de potencia de la inyección (máximo de cada segundo produciendo)" },
        "run_sd_pct": { "type": "number", "minimum": 0, "description": "Variación de la potencia media de cada minuto produciendo (desviación, % de run_kw)" },
        "heatup_peak_kw": { "type": "number", "minimum": 0, "description": "Potencia al encender en frío (resistencias a tope)" }
      }
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Energía de la planta en kWh (sin precio): perfiles por inyectora y molde, y servicios. Lo genera tools/energy/",
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "off_outside_shifts": { "type": "boolean", "description": "Las inyectoras se apagan fuera de turno y los días sin turno" },
            "preheat": { "enum": ["before_first_lot"], "description": "El calentamiento termina cuando empieza el primer lote del día" }
          }
        },
        "injection": { "type": "object", "description": "inyectora → molde → perfil", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/energyProfile" } } },
        "services": {
          "type": "object",
          "description": "Servicios que trabajan para las inyectoras; los de respaldo no van",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nominal_kw", "idle_fraction"],
            "properties": {
              "name": { "type": "string" },
              "nominal_kw": { "type": "number", "minimum": 0, "description": "Potencia con toda la producción andando" },
              "idle_fraction": { "type": "number", "minimum": 0, "maximum": 1, "description": "Parte de nominal_kw con las inyectoras encendidas sin producir" },
              "feeds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "description": "Resinas que atiende (sin feeds, todas las inyectoras)" },
              "source": { "type": "string" }
            }
          }
        },
        "transformer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "limit_kw"],
          "description": "Límite de la acometida: placa del transformador × factor de potencia",
          "properties": {
            "id": { "type": "string" },
            "rating_kva": { "type": "number", "minimum": 0 },
            "power_factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "limit_kw": { "type": "number", "minimum": 0 }
          }
        },
        "assumed": { "type": "boolean" }
      }
    },
    "changeoverTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_min": { "type": "number", "minimum": 0 },
        "pairs": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }, "description": "material de origen → material de destino → minutos" }
      }
    },
    "changeovers": {
      "type": "object",
      "additionalProperties": false,
      "description": "Tiempos de cambio entre referencias: purga de color y de resina por par de materiales (inyección); limpieza por grupo de alérgenos y CIP (alimentos). Tablas de → a",
      "properties": {
        "color": { "$ref": "#/$defs/changeoverTable" },
        "resin": { "$ref": "#/$defs/changeoverTable" },
        "mold_move_extra_min": { "type": "number", "minimum": 0 },
        "sequence": { "type": "object", "description": "Orden de recetas por línea de proceso (alimentos): avanzar en el orden es cambio de receta; devolverse exige CIP completo", "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 } },
        "tank": { "type": "object", "additionalProperties": false, "description": "Pulmón: lavado del tanque cuando el granel se vence y se bota", "properties": { "dump_cip_min": { "type": "number", "minimum": 0, "description": "CIP del pulmón antes de recibir la tanda siguiente" } } },
        "nozzle": { "type": "object", "additionalProperties": false, "description": "Limpieza intermedia de boquillas de la llenadora", "properties": { "every_h": { "type": "number", "exclusiveMinimum": 0, "description": "Horas de llenado sin limpiar tras las que se limpian las boquillas" }, "min": { "type": "number", "minimum": 0, "description": "Duración de la limpieza de boquillas" } } },
        "allergen": { "$ref": "#/$defs/changeoverTable", "description": "Limpieza entre dos productos distintos en un equipo húmedo compartido, por grupo de alérgenos (allergen_group del producto, de → a)" },
        "cip": {
          "type": "object",
          "additionalProperties": false,
          "description": "Limpieza en sitio (CIP) de los equipos húmedos",
          "properties": {
            "short_min": { "type": "number", "minimum": 0, "description": "CIP corto: enjuague, soda y enjuague" },
            "full_min": { "type": "number", "minimum": 0, "description": "CIP completo: soda, ácido, sanitizante y verificación con hisopo" },
            "max_run_h": { "type": "number", "exclusiveMinimum": 0, "description": "Horas de producción continua tras las que el equipo exige CIP completo de rutina" },
            "routine_min": { "type": "number", "minimum": 0, "description": "Duración del CIP de rutina, al acumular max_run_h de producción" }
          }
        },
        "assumed": { "type": "boolean" }
      }
    },
    "mounted": {
      "type": "object",
      "required": ["tooling"],
      "additionalProperties": false,
      "properties": { "tooling": { "$ref": "#/$defs/id" }, "color": { "$ref": "#/$defs/id" } }
    },
    "demand": {
      "type": "object",
      "description": "Demanda de la demo: con ella twin_runtime.planning genera los pedidos de cualquier fecha (fase E, docs/datos-reales.md).",
      "required": ["load_pct", "workdays", "shifts", "products"],
      "additionalProperties": false,
      "properties": {
        "load_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 150 },
        "timezone": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" },
        "workdays": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 }, "minItems": 1 },
        "shifts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }
            }
          }
        },
        "lead_days": { "$ref": "#/$defs/range" },
        "rush": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "share_pct": { "type": "number", "minimum": 0, "maximum": 100 }, "lead_days": { "$ref": "#/$defs/range" } }
        },
        "late": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "share_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "hold_hours": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2,
              "description": "Horas después de la entrega en que llega el insumo (negativo = antes)"
            },
            "materials": { "type": "array", "items": { "$ref": "#/$defs/id" } }
          }
        },
        "downtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "per_day_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "hours": { "$ref": "#/$defs/range" },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "color_change_min": { "type": "number", "minimum": 0 },
        "customers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["product", "daily", "order_qty"],
            "additionalProperties": false,
            "properties": {
              "product": { "$ref": "#/$defs/id" },
              "daily": { "type": "number", "exclusiveMinimum": 0, "description": "Capacidad diaria del producto en su unidad" },
              "order_qty": { "$ref": "#/$defs/range" },
              "round": { "type": "number", "exclusiveMinimum": 0, "description": "Las cantidades son múltiplo de esto (unidades por caja, piezas por fajo)" }
            }
          }
        }
      }
    },
    "order": {
      "type": "object",
      "required": ["id", "product", "quantity", "due"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "product": { "$ref": "#/$defs/id" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "due": { "type": "string", "format": "date-time" },
        "color": { "$ref": "#/$defs/id" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "customer": { "type": "string" }
      }
    },
    "assignment": {
      "type": "object",
      "required": ["order", "stage", "equipment", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "order": { "type": "string" },
        "stage": { "type": "string" },
        "equipment": { "type": "string" },
        "tooling": { "$ref": "#/$defs/id" },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "changeover_min": { "type": "number", "minimum": 0 }
      }
    }
  }
}
