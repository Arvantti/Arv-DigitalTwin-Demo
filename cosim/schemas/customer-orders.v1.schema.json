{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cosim/customer-orders.v1",
  "title": "Cartera de pedidos del cliente",
  "description": "Pedidos que entran al APS. Fechas ISO con la zona de la planta (p. ej. 2026-11-04T22:00-05:00).",
  "type": "object",
  "required": ["contract", "plant", "portfolio_id", "timezone", "plan_start", "orders"],
  "properties": {
    "contract": { "const": "customer-orders.v1" },
    "plant": { "type": "string" },
    "portfolio_id": { "type": "string" },
    "timezone": { "type": "string", "pattern": "^[+-]\\d{2}:\\d{2}$" },
    "plan_start": { "type": "string" },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "customer", "product", "quantity", "due", "created", "importance"],
        "properties": {
          "id": { "type": "string" },
          "customer": { "type": "string" },
          "product": { "type": "string" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string" },
          "color": { "type": "string" },
          "due": { "type": "string" },
          "created": { "type": "string" },
          "importance": { "enum": ["alta", "normal", "baja"] },
          "added": { "type": "boolean" }
        }
      }
    }
  }
}
