{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/fractal-optimization/v2/result.schema.json",
  "title": "Fractal optimization result v2",
  "type": "object",
  "required": ["contract_version", "kind", "snapshot_id", "simulation_time_s", "objective_id", "target_pressure_mca", "applied", "requires_operator_acceptance"],
  "properties": {
    "contract_version": { "const": "fractal-optimization-result.v2" },
    "kind": { "enum": ["instant", "profile-horizon"] },
    "snapshot_id": { "type": "string" },
    "simulation_time_s": { "type": "number" },
    "profile_id": { "type": ["string", "null"] },
    "profile_hash": { "type": ["string", "null"] },
    "objective_id": { "const": "OBJ-PRESSURE-MIN" },
    "target_pressure_mca": { "type": "number", "minimum": 10, "maximum": 45 },
    "temporal_context": { "enum": ["forecast", "history-present-forecast"] },
    "applied": { "const": false },
    "requires_operator_acceptance": { "type": "boolean" },
    "recommendation": { "type": "object" },
    "hours": { "type": "array" },
    "draft_profile": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
