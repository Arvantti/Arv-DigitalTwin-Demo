{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/fractal-optimization/v1/result.schema.json",
  "title": "Fractal optimization result v1",
  "type": "object",
  "required": ["contract_version", "kind", "snapshot_id", "simulation_time_s", "applied", "requires_operator_acceptance"],
  "properties": {
    "contract_version": { "const": "fractal-optimization-result.v1" },
    "kind": { "enum": ["instant", "profile-horizon"] },
    "snapshot_id": { "type": "string" },
    "simulation_time_s": { "type": "number" },
    "applied": { "const": false },
    "requires_operator_acceptance": { "type": "boolean" },
    "recommendation": { "type": "object" },
    "hours": { "type": "array" },
    "draft_profile": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
