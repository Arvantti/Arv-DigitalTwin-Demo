{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/fractal-optimization/v1/job-request.schema.json",
  "title": "Fractal optimization job request v1",
  "type": "object",
  "required": ["contract_version", "kind", "snapshot", "objective_id"],
  "properties": {
    "contract_version": { "const": "fractal-optimization-job.v1" },
    "kind": { "enum": ["instant", "profile-horizon"] },
    "objective_id": { "const": "OBJ-LEAK-01" },
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "simulation_time_s", "plc_tags"],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "simulation_time_s": { "type": "number", "minimum": 0 },
        "plc_tags": { "type": "object" }
      },
      "additionalProperties": false
    },
    "profile": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "profile-horizon" } } }, "then": { "required": ["profile"] } }
  ],
  "additionalProperties": false
}
