{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/cosimulation/v1/job-status.schema.json",
  "title": "Cosimulation job status v1",
  "type": "object",
  "required": ["contract_version", "job_id", "status", "created_at", "updated_at"],
  "properties": {
    "contract_version": { "const": "cosimulation-job.v1" },
    "job_id": { "type": "string" },
    "status": { "enum": ["queued", "running", "succeeded", "failed", "blocked"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "result": { "type": ["object", "null"] },
    "error": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
