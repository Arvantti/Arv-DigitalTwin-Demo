{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/cosimulation/v1/job-request.schema.json",
  "title": "Cosimulation job request v1",
  "type": "object",
  "required": ["contract_version", "plant_id", "initial_snapshot", "profile", "time_step_s", "horizon_s"],
  "properties": {
    "contract_version": { "const": "cosimulation-job.v1" },
    "plant_id": { "type": "string", "minLength": 1 },
    "initial_snapshot": {
      "type": "object",
      "required": ["snapshot_id", "simulation_time_s", "emulator_state", "fractal_state"],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "simulation_time_s": { "type": "number", "minimum": 0 },
        "emulator_state": { "type": "object" },
        "fractal_state": { "type": "object" }
      },
      "additionalProperties": true
    },
    "profile": { "type": "object", "required": ["hours"], "properties": { "id": { "type": "string" }, "hours": { "type": "object" } }, "additionalProperties": true },
    "time_step_s": { "type": "number", "exclusiveMinimum": 0 },
    "horizon_s": { "type": "number", "exclusiveMinimum": 0 }
  },
  "additionalProperties": false
}
