{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/cosimulation/v2/model-result.schema.json",
  "title": "Single cosimulation model projection result v2",
  "type": "object",
  "required": ["contract_version", "model_id", "profile_hash", "quality", "frames"],
  "properties": {
    "contract_version": { "const": "cosimulation-model-result.v2" },
    "model_id": { "type": "string", "minLength": 1 },
    "profile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "quality": { "type": "string", "minLength": 1, "description": "Evidencia y límites declarados del modelo; no equivale a validación física." },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["simulation_time_s", "temporal_context", "state"],
        "properties": {
          "simulation_time_s": { "type": "number", "minimum": 0 },
          "temporal_context": { "enum": ["history", "present", "forecast"] },
          "state": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
