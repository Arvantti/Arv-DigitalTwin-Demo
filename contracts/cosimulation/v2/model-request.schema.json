{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/cosimulation/v2/model-request.schema.json",
  "title": "Single cosimulation model projection request v2",
  "type": "object",
  "required": ["contract_version", "job_id", "plant_id", "session_id", "profile_id", "profile_hash", "profile", "initial_snapshot", "history_frames", "time_step_s", "horizon_s"],
  "properties": {
    "contract_version": { "const": "cosimulation-model-request.v2" },
    "job_id": { "type": "string", "minLength": 1 },
    "plant_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profile": { "type": "object" },
    "initial_snapshot": { "type": "object" },
    "history_frames": { "type": "array" },
    "time_step_s": { "type": "number", "exclusiveMinimum": 0 },
    "horizon_s": { "type": "number", "exclusiveMinimum": 0 }
  },
  "additionalProperties": false
}
