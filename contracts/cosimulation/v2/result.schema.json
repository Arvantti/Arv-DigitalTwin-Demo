{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/cosimulation/v2/result.schema.json",
  "title": "Cosimulation result v2 — one model, independently stored",
  "type": "object",
  "required": ["contract_version", "job_id", "session_id", "snapshot_id", "profile_id", "profile_hash", "model_id", "model_quality", "time_origin_s", "time_step_s", "horizon_s", "forecast_times_s", "source", "applied_to_plc", "frames"],
  "properties": {
    "contract_version": { "const": "cosimulation-result.v2" },
    "job_id": { "type": "string" },
    "session_id": { "type": "string" },
    "snapshot_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "profile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_id": { "type": "string" },
    "model_quality": { "type": "string", "minLength": 1 },
    "time_origin_s": { "type": "number" },
    "time_step_s": { "type": "number", "exclusiveMinimum": 0 },
    "horizon_s": { "type": "number", "exclusiveMinimum": 0 },
    "forecast_times_s": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "type": "number", "minimum": 0 } },
    "source": { "const": "cosimulation" },
    "applied_to_plc": { "const": false },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["simulation_time_s", "temporal_context", "state"],
        "properties": {
          "simulation_time_s": { "type": "number", "minimum": 0 },
          "temporal_context": { "enum": ["history", "present", "forecast"] },
          "state": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
