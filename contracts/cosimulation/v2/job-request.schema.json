{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvantti.example/contracts/cosimulation/v2/job-request.schema.json",
  "title": "Cosimulation job request v2 — single model",
  "type": "object",
  "required": ["contract_version", "plant_id", "session_id", "initial_snapshot", "history_frames", "profile", "profile_hash", "time_step_s", "horizon_s"],
  "properties": {
    "contract_version": { "const": "cosimulation-job.v2" },
    "plant_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "initial_snapshot": {
      "type": "object",
      "required": ["snapshot_id", "simulation_time_s", "plc_tags"],
      "properties": {
        "snapshot_id": { "type": "string", "minLength": 1 },
        "simulation_time_s": { "type": "number", "minimum": 0 },
        "plc_tags": { "type": "object" }
      },
      "additionalProperties": false
    },
    "history_frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["simulation_time_s", "plc_tags"],
        "properties": {
          "simulation_time_s": { "type": "number", "minimum": 0 },
          "plc_tags": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "hours"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "hours": { "type": "object" } },
      "additionalProperties": true
    },
    "profile_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "time_step_s": { "type": "number", "exclusiveMinimum": 0 },
    "horizon_s": { "type": "number", "exclusiveMinimum": 0 }
  },
  "additionalProperties": false
}
