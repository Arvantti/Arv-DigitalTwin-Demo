# Build context: raíz del repositorio (`podman build -f apps/fractal-engineering-api/Containerfile .`).
FROM python:3.12-slim-bookworm

WORKDIR /app
RUN pip install --no-cache-dir uv==0.12.5
COPY . .
RUN uv sync --frozen --no-dev --package fractal-engineering-api

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8100
CMD ["uvicorn", "fractal_engineering_api.main:app", "--host", "0.0.0.0", "--port", "8100"]
