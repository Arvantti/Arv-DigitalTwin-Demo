# Build context: raíz del repositorio.
FROM python:3.12-slim-bookworm
WORKDIR /app
RUN pip install --no-cache-dir uv==0.12.5
COPY . .
RUN uv sync --frozen --no-dev --package cosimulation-engine-api
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8300
CMD ["uvicorn", "cosimulation_engine_api.main:app", "--host", "0.0.0.0", "--port", "8300"]
